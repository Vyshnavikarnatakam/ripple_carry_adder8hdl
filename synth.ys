# 1. Read the design file generated by GHDL
read_ilang rca_design.il

# 2. Establish the strict hardware unit hierarchy
hierarchy -top rca_8bit

# 3. Synthesize behavioral code and clean out dead logic paths
proc; opt; fsm; opt; memory; opt

# 4. Force expressions into basic logic gate maps
techmap; opt

# 5. Break down separate components into flat net connections
flatten

# 6. Purge intermediate unused nodes
opt_clean -purge

# 7. Write the finalized structural output out to Verilog format
write_verilog gate_level_netlist.v

# 8. Print out the final gate resource budget
stat

